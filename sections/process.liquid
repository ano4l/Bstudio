<section class="section process"><div class="section-head"><div><p class="eyebrow">Your appointment</p><h2>{{ section.settings.heading }}</h2></div></div><div class="steps">{% for block in section.blocks %}<article class="step" {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></section>
{% schema %}{"name":"How it works","settings":[{"type":"text","id":"heading","label":"Heading","default":"A calm path to your finish."}],"blocks":[{"type":"step","name":"Step","limit":3,"settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Text"}]}],"presets":[{"name":"How it works","blocks":[{"type":"step","settings":{"title":"Choose your service","text":"Select the install or finishing service that best fits your unit and desired result."}},{"type":"step","settings":{"title":"Request your time","text":"Share your preferred appointment date and time. We will review availability."}},{"type":"step","settings":{"title":"Prepare to arrive","text":"Follow the preparation guide and wait for confirmation before making your way to the studio."}}]}]}{% endschema %}
