<section class="booking-layout"><div class="booking-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(max-width:600px) 100vw, 50vw', widths: '600,900,1200,1400' }}{% else %}{{ 'studio-curly-install.jpg' | asset_url | image_tag: alt: product.title }}{% endif %}</div><div class="booking-copy"><p class="eyebrow">Bambï Studio appointment</p><h1>{{ product.title }}</h1><p class="price">{{ product.price | money }}</p><div class="description">{{ product.description }}</div><div class="facts"><div class="fact"><span>Duration</span><b>{{ product.metafields.custom.duration | default: 'Set in service metafield' }}</b></div><div class="fact"><span>Includes</span><b>{{ product.metafields.custom.inclusions | default: 'See service description' }}</b></div></div>{% form 'product', product, class: 'booking-form' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% unless product.has_only_default_variant %}<fieldset class="form-group"><legend>Service</legend><div class="field"><label for="Variant-{{ section.id }}">Service option</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select></div></fieldset>{% endunless %}<fieldset class="form-group"><legend>Appointment preference</legend><p class="required-note">Both fields are required. Preferences are reviewed before confirmation.</p><div class="field-row"><div class="field"><label for="Date-{{ section.id }}">Preferred date *</label><input id="Date-{{ section.id }}" data-appointment-date type="date" name="properties[Appointment date]" required></div><div class="field"><label for="Time-{{ section.id }}">Preferred time *</label><input id="Time-{{ section.id }}" type="time" name="properties[Appointment time preference]" required></div></div></fieldset><fieldset class="form-group"><legend>Finishing notes</legend><div class="field"><label for="Stylist-{{ section.id }}">Stylist preference <span>(optional)</span></label><input id="Stylist-{{ section.id }}" name="properties[Stylist preference]" placeholder="No preference"></div><div class="field"><label for="Notes-{{ section.id }}">Appointment notes <span>(optional)</span></label><textarea id="Notes-{{ section.id }}" name="properties[Appointment notes]"></textarea></div></fieldset><div class="acknowledgement"><label class="check"><input type="checkbox" name="properties[Preparation acknowledged]" value="Yes" required><span><strong>Preparation acknowledged *</strong>I have read the preparation guidance and understand that this is an appointment request.</span></label></div><p class="booking-notice">{{ section.settings.notice }}</p><button class="button booking-submit" type="submit"{% unless product.available %} disabled{% endunless %}>Reserve this appointment <span>→</span></button>{% endform %}<div class="app-slot">{% content_for 'blocks' %}<p>A booking app can display live availability here. Without one, the form above captures preferences only.</p></div></div></section>
{% schema %}{"name":"Booking service","settings":[{"type":"textarea","id":"notice","label":"Confirmation notice","default":"Your appointment is confirmed only after availability is reviewed."}],"blocks":[{"type":"@app"}]}{% endschema %}
