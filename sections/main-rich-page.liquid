<section class="page-hero"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ page.title }}</h1>{% if section.settings.intro != blank %}<p>{{ section.settings.intro }}</p>{% endif %}</section><article class="content-page">{{ page.content }}{% if section.settings.guidance != blank %}<div class="merchant-note"><strong>Studio guidance</strong><p>{{ section.settings.guidance }}</p></div>{% endif %}</article>
{% schema %}{"name":"Editorial page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Bambï Beauty Bookings"},{"type":"textarea","id":"intro","label":"Intro"},{"type":"richtext","id":"guidance","label":"Configurable guidance"}]}{% endschema %}
