<section class="page-hero"><p class="eyebrow">A note to the studio</p><h1>{{ page.title }}</h1><p>Tell us what you need and our studio will respond with care.</p></section><section class="content-page contact-grid"><div><p class="eyebrow">Direct contact</p><h2>Let’s talk about your finish.</h2><p><a href="mailto:bambi.southafrica@gmail.com">bambi.southafrica@gmail.com</a></p>{% if section.settings.location != blank %}<p>{{ section.settings.location }}</p>{% endif %}{% if section.settings.hours != blank %}<p>{{ section.settings.hours }}</p>{% endif %}</div>{% form 'contact', class: 'contact-form' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">Thank you. Your message has been sent.</p>{% endif %}<div class="field"><label for="ContactName">Name</label><input id="ContactName" name="contact[name]" required></div><div class="field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" required></div><div class="field"><label for="ContactPhone">Phone <span>(optional)</span></label><input id="ContactPhone" type="tel" name="contact[phone]"></div><div class="field"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" required></textarea></div><button class="button" type="submit">Send enquiry <span>→</span></button>{% endform %}</section>
{% schema %}{"name":"Contact page","settings":[{"type":"text","id":"location","label":"Studio location","info":"Leave blank until confirmed"},{"type":"text","id":"hours","label":"Studio hours","info":"Leave blank until confirmed"}]}{% endschema %}
