<section class="hero">
  <div class="hero-copy fade-in">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="hero-actions"><a class="button light" href="{{ section.settings.primary_link | default: routes.collections_url }}">{{ section.settings.primary_label }} <span>↗</span></a><a class="text-link" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label }}</a></div>
  </div>
  <div class="hero-visual"><span class="hero-number">01</span><div class="hero-frame">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(max-width: 600px) 100vw, 50vw', widths: '600,900,1200,1400', alt: section.settings.image.alt }}{% else %}{{ 'studio-curly-install.jpg' | asset_url | image_tag: loading: 'eager', alt: 'Completed deep-curly Bambï Studio installation' }}{% endif %}</div><span class="hero-note">Craft / fit / finish</span></div>
</section>
{% schema %}{"name":"Studio hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A private finish, made for you"},{"type":"html","id":"heading","label":"Heading","default":"Your hair,<br><em>finished beautifully.</em>"},{"type":"textarea","id":"text","label":"Text","default":"Considered installations, fitting and finishing for hair that feels entirely your own."},{"type":"text","id":"primary_label","label":"Primary button","default":"Book an install"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary link","default":"View services"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"image","label":"Portrait"}],"presets":[{"name":"Studio hero"}]}{% endschema %}
