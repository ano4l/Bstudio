<section class="page-hero"><p class="eyebrow">The treatment menu</p><h1>{{ collection.title | default: 'Studio services' }}</h1><p>{{ collection.description | default: 'Choose the service that meets your unit, your routine and your preferred finish.' }}</p></section><section class="catalogue"><div class="catalogue-note">Curated services · Appointment times reviewed after request</div><div class="service-menu">{% paginate collection.products by 24 %}{% for product in collection.products %}<a class="service-card" href="{{ product.url }}"><span class="num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><h3>{{ product.title }}</h3><p>{{ product.description | strip_html | truncate: 105 }}</p><span class="service-meta">{% if product.metafields.custom.duration != blank %}{{ product.metafields.custom.duration }} · {% endif %}{{ product.price | money }}</span><span class="service-arrow">→</span></a>{% else %}<div class="empty-state"><h2>Services are being prepared.</h2><p>Add service products to this collection in Shopify admin.</p></div>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div></section>
{% schema %}{"name":"Service collection","settings":[]}{% endschema %}
