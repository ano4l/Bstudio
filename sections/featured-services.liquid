<section class="section services">
  <div class="section-head">
    <div><p class="eyebrow">The treatment menu</p><h2>{{ section.settings.heading }}</h2></div>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="service-menu">
    {% assign collection = section.settings.collection %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.limit %}
        {% liquid
          assign fallback_asset = 'service-portfolio/straightening-replacement.jpeg'
          assign image_alt = product.featured_image.alt | default: product.title
          case forloop.index
            when 1
              assign fallback_asset = 'service-portfolio/classic-frontal-ponytail-01.jpeg'
            when 2
              assign fallback_asset = 'service-portfolio/fluffy-ponytail-01.jpeg'
            when 3
              assign fallback_asset = 'service-portfolio/image00010.jpeg'
            when 4
              assign fallback_asset = 'service-portfolio/straightening-replacement.jpeg'
            when 5
              assign fallback_asset = 'service-portfolio/image00015.jpeg'
            when 6
              assign fallback_asset = 'service-portfolio/bob-01.jpeg'
            when 7
              assign fallback_asset = 'service-portfolio/image00018.jpeg'
          endcase
        %}
        <a class="service-card" href="{{ product.url }}">
          <span class="num">0{{ forloop.index }}</span>
          <span class="service-thumb">
            {% if product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180, 360, 600', sizes: '90px', alt: image_alt }}
            {% else %}
              <img src="{{ fallback_asset | asset_url }}" alt="Bambï Beauty finish for {{ product.title | escape }}" width="180" height="220" loading="lazy">
            {% endif %}
          </span>
          <h3>{{ product.title }}</h3>
          <p>{{ product.description | strip_html | truncate: 100 }}</p>
          <span class="service-meta">{% if product.metafields.custom.duration != blank %}<b>{{ product.metafields.custom.duration }}</b>{% endif %}<small>{{ product.price | money }}</small></span>
          <span class="service-arrow">→</span>
        </a>
      {% endfor %}
    {% else %}
      {% for block in section.blocks %}
        {% liquid
          assign fallback_asset = 'service-portfolio/classic-frontal-ponytail-01.jpeg'
          case forloop.index
            when 2
              assign fallback_asset = 'service-portfolio/fluffy-ponytail-01.jpeg'
            when 3
              assign fallback_asset = 'service-portfolio/image00010.jpeg'
            when 4
          assign fallback_asset = 'service-portfolio/straightening-replacement.jpeg'
            when 5
              assign fallback_asset = 'service-portfolio/image00015.jpeg'
            when 6
              assign fallback_asset = 'service-portfolio/bob-01.jpeg'
            when 7
              assign fallback_asset = 'service-portfolio/image00018.jpeg'
          endcase
        %}
        <a class="service-card" href="{{ routes.collections_url }}" {{ block.shopify_attributes }}>
          <span class="num">0{{ forloop.index }}</span>
          <span class="service-thumb"><img src="{{ fallback_asset | asset_url }}" alt="Bambï Beauty finish for {{ block.settings.title | escape }}" width="180" height="220" loading="lazy"></span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <span class="service-meta"><small>View service</small></span>
          <span class="service-arrow">→</span>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{"name":"Featured services","settings":[{"type":"text","id":"heading","default":"Signature services","label":"Heading"},{"type":"textarea","id":"text","default":"Every appointment begins with the right service and ends with a finish tailored to you.","label":"Intro"},{"type":"collection","id":"collection","label":"Services collection"},{"type":"range","id":"limit","min":2,"max":8,"step":1,"default":7,"label":"Services shown"}],"blocks":[{"type":"service","name":"Demo service","settings":[{"type":"text","id":"title","label":"Title","default":"Signature Frontal Install"},{"type":"textarea","id":"text","label":"Text","default":"A precise, polished installation with a considered finish."}]}],"presets":[{"name":"Featured services","blocks":[{"type":"service"},{"type":"service","settings":{"title":"Glueless Unit Fitting"}},{"type":"service","settings":{"title":"Closure Install"}},{"type":"service","settings":{"title":"Refresh & Restyle"}}]}]}
{% endschema %}
