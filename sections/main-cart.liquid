<section class="page-hero"><p class="eyebrow">Your appointment request</p><h1>Review your selection.</h1><p>An appointment is confirmed only after the studio or booking app confirms availability and any payment requirements.</p></section><section class="cart-page">{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<article class="cart-line">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}{% endif %}<div><h2>{{ item.product.title }}</h2><div class="properties">{% for property in item.properties %}{% unless property.last == blank %}<div><strong>{{ property.first }}:</strong> {{ property.last }}</div>{% endunless %}{% endfor %}</div><label>Quantity <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}<div class="cart-total"><p>Total: <strong>{{ cart.total_price | money }}</strong></p><button class="button" type="submit" name="checkout">Continue to checkout <span>→</span></button></div></form>{% else %}<div class="empty-state"><h2>Your request is empty.</h2><p>Choose a studio service to begin.</p><a class="button" href="{{ routes.collections_url }}">View services</a></div>{% endif %}</section>
{% schema %}{"name":"Appointment cart","settings":[]}{% endschema %}
